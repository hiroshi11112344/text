<h1>新規ユーザー登録</h1>

<%= form_with model: @user, url: "/user/create", local: true do |form| %>
  <div>
    <%= form.label :name, "名前"%>
    <%= form.text_field :name, required: true%>
  </div>

  <div>
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email, required: true %>
  </div>

  <div>
    <%= form.submit "登録する" %>
  </div>
<% end %>


